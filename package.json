{
    "name": "@dh-center-tuebingen/dhc-components",
    "version": "0.1.3",
    "type": "module",
    "files": [
        "dist/**/*",
        "node_modules/highlight.js/styles/github-dark.css",
        "node_modules/highlight.js/styles/github.css"
    ],
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./index": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./css": "./dist/style.css",
        "./Blocks/*": {
            "types": "./dist/Blocks/*.d.ts",
            "import": "./dist/Blocks/*.js"
        },
        "./Button/*": {
            "types": "./dist/Button/*.d.ts",
            "import": "./dist/Button/*.js"
        },
        "./Display/*": {
            "types": "./dist/Display/*.d.ts",
            "import": "./dist/Display/*.js"
        },
        "./Dropdown": {
            "types": "./dist/Dropdown.d.ts",
            "import": "./dist/Dropdown.js"
        },
        "./Form/*": {
            "types": "./dist/Form/*.d.ts",
            "import": "./dist/Form/*.js"
        },
        "./Indicators/*": {
            "types": "./dist/Indicators/*.d.ts",
            "import": "./dist/Indicators/*.js"
        },
        "./Input/*": {
            "types": "./dist/Input/*.d.ts",
            "import": "./dist/Input/*.js"
        },
        "./LabeledInput": {
            "types": "./dist/LabeledInput.d.ts",
            "import": "./dist/LabeledInput.js"
        },
        "./Layout/*": {
            "types": "./dist/Layout/*.d.ts",
            "import": "./dist/Layout/*.js"
        },
        "./Multiselect": {
            "types": "./dist/Multiselect.d.ts",
            "import": "./dist/Multiselect.js"
        },
        "./Navigation/*": {
            "types": "./dist/Navigation/*.d.ts",
            "import": "./dist/Navigation/*.js"
        },
        "./Notifications/*": {
            "types": "./dist/Notifications/*.d.ts",
            "import": "./dist/Notifications/*.js"
        },
        "./Views": {
            "types": "./dist/Views.d.ts",
            "import": "./dist/Views.js"
        },
        "./Visuals": {
            "types": "./dist/Visuals.d.ts",
            "import": "./dist/Visuals.js"
        },
        "./composables/*": {
            "types": "./dist/composables/*.d.ts",
            "import": "./dist/composables/*.js"
        },
        "./utils/*": {
            "types": "./dist/utils/*.d.ts",
            "import": "./dist/utils/*.js"
        }
    },
    "scripts": {
        "dev": "vite",
        "build": "run-s type-check build-only",
        "build:watch": "vite build --watch",
        "preview": "vite preview",
        "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
        "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
        "test:unit": "cypress run --component",
        "test:unit:dev": "cypress open --component",
        "build-only": "vite build",
        "type-check": "vue-tsc --noEmit -p .tsconfig/tsconfig.app.json --composite false",
        "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build"
    },
    "peerDependencies": {
        "bootstrap": "^5.3.0",
        "vue": "^3.3.0"
    },
    "dependencies": {
        "@fontsource-variable/figtree": "^5.2.10",
        "@fontsource-variable/fira-code": "^5.2.7",
        "@fontsource/zilla-slab": "^5.2.8",
        "@milkdown/core": "^7.5.0",
        "@milkdown/plugin-clipboard": "^7.5.0",
        "@milkdown/plugin-diagram": "^7.5.0",
        "@milkdown/plugin-emoji": "^7.5.0",
        "@milkdown/plugin-history": "^7.5.0",
        "@milkdown/plugin-indent": "^7.5.0",
        "@milkdown/plugin-listener": "^7.5.0",
        "@milkdown/plugin-math": "^7.5.0",
        "@milkdown/plugin-prism": "^7.5.0",
        "@milkdown/plugin-tooltip": "^7.5.0",
        "@milkdown/plugin-upload": "^7.5.0",
        "@milkdown/preset-commonmark": "^7.5.0",
        "@milkdown/preset-gfm": "^7.5.0",
        "@milkdown/prose": "^7.5.0",
        "@milkdown/theme-nord": "^7.5.0",
        "@milkdown/transformer": "^7.5.0",
        "@milkdown/vue": "^7.5.0",
        "@vueform/multiselect": "^2.6.11",
        "@vuepic/vue-datepicker": "^11.0.2",
        "axios": "^1.11.0",
        "dayjs": "^1.11.13",
        "emoji-mart-vue-fast": "^15.0.4",
        "highlight.js": "^11.11.1",
        "vee-validate": "^4.13.2",
        "vue": "^3.3.0",
        "vue-i18n": "^9.13.1",
        "vue-superselect": "^1.0.0",
        "vue3-select-component": "^0.16.0",
        "yup": "^1.6.1"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^3.2.2",
        "@fortawesome/fontawesome-svg-core": "^6.7.1",
        "@fortawesome/free-brands-svg-icons": "^6.7.1",
        "@fortawesome/free-regular-svg-icons": "^6.7.1",
        "@fortawesome/free-solid-svg-icons": "^6.7.1",
        "@fortawesome/vue-fontawesome": "^3.0.8",
        "@popperjs/core": "^2.11.8",
        "@rushstack/eslint-patch": "^1.3.3",
        "@storybook/addon-backgrounds": "^9.0.8",
        "@storybook/addon-essentials": "8.6.14",
        "@storybook/addon-interactions": "8.6.14",
        "@storybook/addon-links": "8.6.14",
        "@storybook/blocks": "8.6.14",
        "@storybook/test": "8.6.14",
        "@storybook/vue3": "8.6.14",
        "@storybook/vue3-vite": "8.6.14",
        "@tsconfig/node18": "^18.2.2",
        "@types/bootstrap": "^5.2.10",
        "@types/d3-dsv": "^3.0.7",
        "@types/node": "^18.18.5",
        "@vitejs/plugin-vue": "^4.4.0",
        "@vue/eslint-config-typescript": "^14.0.0",
        "@vue/tsconfig": "^0.4.0",
        "bootstrap": "^5.3.3",
        "cypress": "^13.3.1",
        "eslint": "^9.0.0",
        "eslint-plugin-cypress": "^2.15.1",
        "eslint-plugin-storybook": "^0.11.1",
        "eslint-plugin-vue": "^9.17.0",
        "glob": "^13.0.6",
        "npm-run-all2": "^6.1.1",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "sass": "^1.69.5",
        "start-server-and-test": "^2.0.1",
        "storybook": "8.6.14",
        "storybook-addon-vue-slots": "0.9.30-next.2",
        "typescript": "^5.9.3",
        "vite": "^4.4.11",
        "vue-tsc": "^3.3.11"
    }
}